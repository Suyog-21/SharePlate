# =============================================================================
# SharePlate RAG service configuration
# Copy this file to `.env` in this same folder, then fill in real values.
# NEVER commit the real .env file.
# =============================================================================

# --- LLM provider (any OpenAI-compatible /chat/completions API) ---
#
# Default below is configured for xAI (Grok). You can point this at any
# OpenAI-compatible provider by changing these three values.
#
# LLM_CHAT_MODEL must be a model name that is CURRENTLY AVAILABLE on your
# provider account. "grok-4.7" below is only a placeholder default - replace
# it with a real model name from your xAI account (or another provider).
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=YOUR_XAI_API_KEY
LLM_CHAT_MODEL=grok-4.7

# NOTE: This version of the RAG service does NOT use an embeddings API.
# Knowledge retrieval is done with simple local keyword matching
# (see knowledge_base.py), so no LLM_EMBEDDING_MODEL variable is required.
# If you later add an embeddings-based retrieval step, you can introduce an
# LLM_EMBEDDING_MODEL variable then - it is intentionally left out for now.

# --- MySQL database (same database the Express backend uses) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=ecorescue_db

# --- RAG service server settings ---
RAG_PORT=8000
# Comma-separated list of allowed frontend origins (CORS)
RAG_ALLOWED_ORIGINS=http://localhost:5173
